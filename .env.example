# Apple Wallet pass signing — copy this file to `.env` and fill in your values.
# `.env` is git-ignored. None of these are secrets (PASS_TYPE_ID and TEAM_ID are
# embedded in every pass you hand out) EXCEPT PASS_CERT_PASSWORD, which is only
# needed if your signing key (certs/signerKey.pem) is password-protected.

PASS_TYPE_ID=pass.com.yourname.card
TEAM_ID=XXXXXXXXXX
PASS_CERT_PASSWORD=
